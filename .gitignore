# build output
/build/
/c64/sim/out/
/c64/sim/run/

# your own programs and disks: kept out of the repository (only the demo
# and the test disk are in it)
/c64/assets/c64/*
!/c64/assets/c64/README.md
!/c64/assets/c64/demo.prg
!/c64/assets/c64/testdisk.d64
/c64/assets/c64/files.txt

# the Amiga's Kickstart and disks: yours, kept out of the repository
/amiga/assets/amiga/*
!/amiga/assets/amiga/README.md
/amiga/sim/out/
/amiga/sim/run/

# the music players' folders: your music stays out too (only their READMEs are kept)
!/c64/assets/c64/music/
/c64/assets/c64/music/*
!/c64/assets/c64/music/README.md
!/amiga/assets/amiga/mods/
/amiga/assets/amiga/mods/*
!/amiga/assets/amiga/mods/README.md
amiberry/sim/out/
